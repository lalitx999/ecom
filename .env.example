# Copy to .env (or put in the systemd unit) and fill in. Never commit real values.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=generate-with: python -c "import secrets;print(secrets.token_urlsafe(60))"
DJANGO_ALLOWED_HOSTS=shop.example.com
CSRF_TRUSTED_ORIGINS=https://shop.example.com
SITE_URL=https://shop.example.com
SECURE_HSTS_SECONDS=0            # set 31536000 after confirming HTTPS works everywhere

DB_NAME=ecommerce_db
DB_USER=shop
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# Email (without EMAIL_HOST emails are only printed to the log)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=Lumé <no-reply@shop.example.com>
SHOP_NOTIFY_EMAILS=              # extra seller addresses, comma separated (active staff are always notified)

# Footer contact details (any empty value is simply not shown; links must start with http:// or https://)
SHOP_TAGLINE=
SHOP_PHONE=
SHOP_EMAIL=
SHOP_LINE_ID=
SHOP_LINE_URL=
SHOP_HOURS=
SHOP_ADDRESS=
SHOP_FACEBOOK=
SHOP_INSTAGRAM=
SHOP_TIKTOK=
